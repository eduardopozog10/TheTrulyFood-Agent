# Node.js 24.12+; copiar a .env. Nunca subir .env a Git.
PORT=3000
SHOPIFY_STORE=gautier
# live consulta Shopify; demo usa datos ficticios sin conexiones externas.
SHOPIFY_MODE=live
LLM_PROVIDER=simulated
OPENAI_ALLOW_PAID=false
OPENAI_API_KEY=
# Elegir un identificador vigente desde la documentación oficial. Sin valor por defecto.
OPENAI_MODEL=
DATA_DIR=./data
LOG_RETENTION_DAYS=7
MAX_TOOL_CALLS=4
SHOPIFY_TIMEOUT_MS=8000
# Las tarifas son opcionales y requieren revisión manual en config/model-pricing.json.
